---
// One page of the site: the live page's own head and body, with the shared header and footer.
import header from "../components/Header.html?raw";
import footer from "../components/Footer.html?raw";
import { PORTAL_LOGIN_URL } from "../config/links";

export type PageData = { path: string; lang: string; bodyClass: string; head: string; body: string };
interface Props {
  page: PageData;
}
const { page } = Astro.props;

const withLinks = (html: string) => html.replaceAll("{{PORTAL_LOGIN_URL}}", PORTAL_LOGIN_URL);

// The mobile menu sits in each page's body: Patient Login goes after its last link.
const MENU_END = '<a class="tsc-menu__nav-link" href="/journal/">Journal</a></nav>';
let body = page.body;
if (body.includes(MENU_END)) {
  body = body.replace(MENU_END, `<a class="tsc-menu__nav-link" href="/journal/">Journal</a><a class="tsc-menu__nav-link" href="${PORTAL_LOGIN_URL}">Patient Login</a></nav>`);
} else {
  throw new Error(`${page.path}: the mobile menu was not found, so Patient Login could not be added.`);
}
const [beforeHeader, rest] = body.split("<!--SC:HEADER-->");
const [middle, afterFooter] = rest.split("<!--SC:FOOTER-->");
---
<!doctype html>
<html lang={page.lang}>
  <head>
    <Fragment set:html={page.head} />
  </head>
  <body class={page.bodyClass}>
    <Fragment set:html={beforeHeader} /><Fragment set:html={withLinks(header)} /><Fragment set:html={middle} /><Fragment set:html={withLinks(footer)} /><Fragment set:html={afterFooter} />
  </body>
</html>
