":\"en-GB\",\"@id\":\"https:\\/\\/theschoemanclinic.com\\/#\\/schema\\/logo\\/image\\/\",\"url\":\"https:\\/\\/theschoemanclinic.com\\/wp-content\\/uploads\\/2026\\/08\\/schoeman-clinic-logo.png\",\"contentUrl\":\"https:\\/\\/theschoemanclinic.com\\/wp-content\\/uploads\\/2026\\/08\\/schoeman-clinic-logo.png\",\"width\":989,\"height\":491,\"caption\":\"The Schoeman Clinic\"},\"image\":{\"@id\":\"https:\\/\\/theschoemanclinic.com\\/#\\/schema\\/logo\\/image\\/\"},\"sameAs\":[\"https:\\/\\/www.facebook.com\\/profile.php?id=61573288663320\",\"https:\\/\\/www.instagram.com\\/schoemanclinic\",\"https:\\/\\/www.linkedin.com\\/company\\/theschoemanclinic\\/\"],\"medicalSpecialty\":[\"Endocrine\",\"PrimaryCare\"],\"telephone\":\"+442030063224\",\"email\":\"info@theschoemanclinic.com\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"96 Harley Street\",\"addressLocality\":\"London\",\"postalCode\":\"W1G 7HY\",\"addressCountry\":\"GB\"},\"openingHoursSpecification\":[{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\"],\"opens\":\"09:00\",\"closes\":\"17:00\"}],\"location\":[{\"@type\":\"Place\",\"name\":\"The Schoeman Clinic, Harley Street\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"96 Harley Street\",\"addressLocality\":\"London\",\"postalCode\":\"W1G 7HY\",\"addressCountry\":\"GB\"},\"telephone\":\"+442030063224\"},{\"@type\":\"Place\",\"name\":\"The Schoeman Clinic, Wimbledon Village\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"4 St Marks Place, Wimbledon\",\"addressLocality\":\"London\",\"postalCode\":\"SW19 7NP\",\"addressCountry\":\"GB\"},\"telephone\":\"+442030063224\"}]}]}"
