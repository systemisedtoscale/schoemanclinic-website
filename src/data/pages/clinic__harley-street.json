  "main": "\n<main class=\"tsc-clinic\">\n\t<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"MedicalClinic\",\"name\":\"The Schoeman Clinic, Harley Street\",\"description\":\"Specialist hormone, functional and longevity medicine at The Schoeman Clinic on Harley Street, London.\",\"url\":\"/clinic/harley-street/\",\"telephone\":\"+44 20 3006 3224\",\"email\":\"info@theschoemanclinic.com\",\"image\":\"/wp-content/uploads/2026/08/clinic-harley-street.webp\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"96 Harley Street\",\"addressLocality\":\"London\",\"addressRegion\":\"London\",\"postalCode\":\"W1G 7HY\",\"addressCountry\":\"GB\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":51.521011,\"longitude\":-0.150164},\"availableService\":[{\"@type\":\"MedicalTherapy\",\"name\":\"Hormone health & optimisation\"},{\"@type\":\"MedicalTherapy\",\"name\":\"Longevity & functional medicine\"},{\"@type\":\"MedicalTherapy\",\"name\":\"Metabolic health\"},{\"@type\":\"MedicalTherapy\",\"name\":\"Digestive health\"},{\"@type\":\"MedicalTherapy\",\"name\":\"Diagnostics & supportive services\"}]}</script>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do I need a GP referral?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. You may self-refer directly by phone, email or online enquiry. We recommend keeping your GP informed of any specialist care you receive.\"}},{\"@type\":\"Question\",\"name\":\"Can I be seen online instead of in person?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. The Schoeman Clinic is a hybrid practice. Initial and follow-up consultations, blood testing, prescriptions and repeat testing can all be managed remotely.\"}},{\"@type\":\"Question\",\"name\":\"Can I switch between Wimbledon and Harley Street?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Care is shared seamlessly between our two London clinics, so you can attend whichever location suits you without repeating your history.\"}},{\"@type\":\"Question\",\"name\":\"Is parking available nearby?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Metered street parking and several public car parks are available near Harley Street. We recommend checking current availability before your appointment.\"}},{\"@type\":\"Question\",\"name\":\"What conditions are treated at Harley Street?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Our Harley Street clinic covers the full scope of our work: hormone health, longevity, metabolic and digestive health, plus diagnostics and supportive care.\"}},{\"@type\":\"Question\",\"name\":\"How long is an initial consultation?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Initial consultations are generous, allowing time for a full history and discussion of your goals. We will confirm the exact duration when you book.\"}}]}</script>\n\n\n<section class=\"tsc-clinic__hero\">\n\t<div class=\"tsc-clinic__shell\">\n\t\t<nav class=\"tsc-clinic__crumb\" aria-label=\"Breadcrumb\" style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms\">\n\t\t\t<a href=\"/\">The Practice</a>\n\t\t\t<span aria-hidden=\"true\">/</span>\n\t\t\t<span>Our Clinics</span>\n\t\t\t<span aria-hidden=\"true\">/</span>\n\t\t\t<strong>Harley Street</strong>\n\t\t</nav>\n\t\t<div class=\"tsc-clinic__hero-grid\">\n\t\t\t<div class=\"tsc-clinic__hero-copy\">\n\t\t\t\t<h1 style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 140ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 140ms\">Harley Street</h1>\n\t\t\t\t<address style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 200ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 200ms\">\n\t\t\t\t\tThe Schoeman Clinic<br> 96 Harley Street<br> London W1G 7HY\t\t\t\t</address>\n\t\t\t\t<p class=\"tsc-clinic__lede\" style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 260ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 260ms\">Specialist hormonal health, functional medicine and longevity care in London’s established private medical quarter.</p>\n\t\t\t\t<div class=\"tsc-clinic__actions\" style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 320ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 320ms\">\n\t\t\t\t\t<a class=\"btn-luxe\" href=\"/book/\">Book at Harley Street</a>\n\t\t\t\t\t\t\t\t\t\t\t<a class=\"btn-ghost-luxe\" href=\"https://www.google.com/maps/search/?api=1&query=96%20Harley%20Street%2C%20London%20W1G%207HY\" target=\"_blank\" rel=\"noopener\">Get directions</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"tsc-clinic__hero-image\" style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 160ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 160ms\">\n\t\t\t\t<img class=\"tsc-kenburns\" src=\"/wp-content/uploads/2026/08/clinic-harley-street.webp\" alt=\"The Schoeman Clinic on Harley Street in London\" width=\"1200\" height=\"828\" loading=\"eager\" fetchpriority=\"high\" decoding=\"async\">\n\t\t\t\t<span aria-hidden=\"true\"></span>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>\n\n\n<section class=\"tsc-clinic__section\">\n\t<div class=\"tsc-clinic__shell tsc-clinic__detail-grid\">\n\t\t<div class=\"tsc-clinic__prose\" style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms\">\n\t\t\t<div class=\"eyebrow\">The clinic</div>\n\t\t\t<h2>Specialist care on Harley Street.</h2>\n\t\t\t\t\t\t\t<p>The Schoeman Clinic’s Harley Street location sits at 96 Harley Street, at the heart of London’s most established private medical quarter. This is the clinic’s primary in-person location and the base from which Dr Gina Schoeman delivers specialist care in hormonal health, functional medicine and longevity medicine to patients from across London and beyond.</p>\n\t\t\t\t\t\t\t<p>Harley Street has been synonymous with specialist private medicine for well over a century. The Schoeman Clinic occupies its place within that tradition as a forward-looking clinical practice, combining the investigative depth of functional medicine with the most current science of hormonal health and biological ageing.</p>\n\t\t\t\t\t\t\t<p>The Schoeman Clinic is a hybrid practice. Consultations are available in person at Harley Street, at our Wimbledon location, and online for patients anywhere in the United Kingdom. Whichever format you choose, you receive the same depth of clinical assessment, personalised treatment planning and continuity of care. Adult patients of all genders are welcome from the age of 18. No GP referral is required.</p>\n\t\t\t\t\t</div>\n\t\t<aside class=\"tsc-clinic__info\" style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 140ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 140ms\">\n\t\t\t<section>\n\t\t\t\t<h3 class=\"eyebrow\">Opening hours</h3>\n\t\t\t\t<dl class=\"tsc-clinic__hours\">\n\t\t\t\t\t\t\t\t\t\t\t<div><dt>Monday – Friday</dt><dd>9:00 – 17:00</dd></div>\n\t\t\t\t\t\t\t\t\t\t\t<div><dt>Saturday – Sunday</dt><dd>Closed</dd></div>\n\t\t\t\t\t\t\t\t\t</dl>\n\t\t\t</section>\n\t\t\t<section>\n\t\t\t\t<h3 class=\"eyebrow\">Getting here</h3>\n\t\t\t\t<dl class=\"tsc-clinic__travel\">\n\t\t\t\t\t\t\t\t\t\t\t<div><dt>By underground</dt><dd>Regent’s Park is approximately a five-minute walk. Great Portland Street and Oxford Circus are also within easy reach.</dd></div>\n\t\t\t\t\t\t\t\t\t\t\t<div><dt>By car</dt><dd>Metered street parking and several public car parks are available nearby. We recommend checking current availability before your appointment.</dd></div>\n\t\t\t\t\t\t\t\t\t</dl>\n\t\t\t</section>\n\t\t\t<section>\n\t\t\t\t<h3 class=\"eyebrow\">Contact</h3>\n\t\t\t\t<a href=\"tel:+442030063224\">+44 (0)20 3006 3224</a>\n\t\t\t\t<a href=\"mailto:info@theschoemanclinic.com\">info@theschoemanclinic.com</a>\n\t\t\t</section>\n\t\t</aside>\n\t</div>\n</section>\n\n\n<section class=\"tsc-clinic__services-band\">\n\t<div class=\"tsc-clinic__shell\">\n\t\t<div class=\"tsc-clinic__services-heading\" style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms\">\n\t\t\t<div class=\"eyebrow\">Services available at Harley Street</div>\n\t\t\t<p>The clinic’s complete specialist service is available in person on Harley Street and through secure online consultation.</p>\n\t\t</div>\n\t\t<ul class=\"tsc-clinic__services\">\n\t\t\t\t\t\t\t<li style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms\">\n\t\t\t\t\t<a href=\"/hormone-health/\">Hormone health &amp; optimisation</a>\n\t\t\t\t</li>\n\t\t\t\t\t\t\t<li style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 70ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 70ms\">\n\t\t\t\t\t<a href=\"/longevity-functional/\">Longevity &amp; functional medicine</a>\n\t\t\t\t</li>\n\t\t\t\t\t\t\t<li style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 140ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 140ms\">\n\t\t\t\t\t<a href=\"/metabolic-health/\">Metabolic health</a>\n\t\t\t\t</li>\n\t\t\t\t\t\t\t<li style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 210ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 210ms\">\n\t\t\t\t\t<a href=\"/digestive-health/\">Digestive health</a>\n\t\t\t\t</li>\n\t\t\t\t\t\t\t<li style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 280ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 280ms\">\n\t\t\t\t\t<a href=\"/diagnostics/\">Diagnostics &amp; supportive services</a>\n\t\t\t\t</li>\n\t\t\t\t\t</ul>\n\t</div>\n</section>\n\n\n<section class=\"tsc-clinic__section tsc-clinic__section--stone\">\n\t<div class=\"tsc-clinic__shell tsc-clinic__split-heading\">\n\t\t<div style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms\">\n\t\t\t<div class=\"eyebrow\">How it works</div>\n\t\t\t<h2>Your patient journey</h2>\n\t\t\t<p>From first enquiry through to ongoing care, every step is designed to be clear, unhurried and focused on your outcomes.</p>\n\t\t</div>\n\t\t<div class=\"tsc-clinic__journey\">\n\t\t\t\t\t\t\t<article style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms\">\n\t\t\t\t\t<span>01</span>\n\t\t\t\t\t<h3>Enquiry</h3>\n\t\t\t\t\t<p>Share your concerns by phone, email or online form. We will help you choose the most suitable consultation location and format.</p>\n\t\t\t\t</article>\n\t\t\t\t\t\t\t<article style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 90ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 90ms\">\n\t\t\t\t\t<span>02</span>\n\t\t\t\t\t<h3>Consultation &amp; diagnostics</h3>\n\t\t\t\t\t<p>Your first appointment is unhurried. After a detailed history, we arrange targeted blood tests, often on-site the same day.</p>\n\t\t\t\t</article>\n\t\t\t\t\t\t\t<article style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 180ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 180ms\">\n\t\t\t\t\t<span>03</span>\n\t\t\t\t\t<h3>Personalised plan</h3>\n\t\t\t\t\t<p>You receive a clear, evidence-based treatment plan with follow-up and ongoing monitoring in person or online.</p>\n\t\t\t\t</article>\n\t\t\t\t\t</div>\n\t</div>\n</section>\n\n\n<section id=\"fees\" class=\"tsc-clinic__fees border-y\">\n\t<div class=\"mx-auto max-w-[1440px] px-6 py-20 md:px-12 md:py-28\">\n\t\t<div class=\"mx-auto max-w-3xl text-center\">\n\t\t\t<div style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms\"><div class=\"eyebrow justify-center\">Learn</div></div>\n\t\t\t<div style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 100ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 100ms\"><h2 class=\"mt-5 font-serif text-[2rem] leading-[1.12] tracking-[-0.005em] md:text-[2.6rem]\">Consultation fees at the Harley Street clinic</h2></div>\n\t\t\t<div style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 200ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 200ms\"><p class=\"mt-6 text-[1.02rem] leading-[1.75] text-[color:var(--muted-foreground)]\">The Schoeman Clinic operates as a self-pay private clinic. Hormone health and functional medicine consultations are not routinely covered by health insurance. Where we refer you for further specialist investigations, those referrals may attract reimbursement depending on your policy. Please contact your insurer directly to confirm your coverage. Fees are the same for in-person and online consultations.</p></div>\n\t\t</div>\n\t\t<div class=\"mx-auto mt-16 max-w-[1000px] border\" style=\"border-color:color-mix(in oklab, var(--bronze) 20%, transparent);background:var(--stone-warm);padding:clamp(2rem,4vw,3.5rem)\">\n\t\t\t<div class=\"grid gap-12 md:grid-cols-2 md:gap-16\">\n\t\t\t\t\t\t\t\t\t<div style=\"opacity: 1;transform: translateY(0px);transition:opacity 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms, transform 1100ms cubic-bezier(0.2,0.7,0.2,1) 0ms\">\n\t\t\t\t\t\t<div class=\"eyebrow\">Initial consultations</div>\n\t\t\t\t\t\t<div cla